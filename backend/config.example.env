# Reference only: copy values into backend/.env and replace placeholders.
DATABASE_URL=mysql://parking_app:replace-me@127.0.0.1:3306/smart_parking
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=parking_app
DB_PASSWORD=replace-me
DB_NAME=smart_parking
PORT=5000
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generate a private random value of at least 32 characters before live sign-in.
ADMIN_SESSION_SECRET=
# Provisioning only; remove ADMIN_PASSWORD after creating the administrator.
# ADMIN_EMAIL=your-admin-email@example.com
# ADMIN_NAME=Platform Administrator
# ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
